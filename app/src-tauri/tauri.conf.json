{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BHCapture",
  "version": "1.1.0",
  "identifier": "com.biswashost.bhcapture",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "publisher": "BiswasHost",
    "copyright": "Copyright (c) 2026 Benjamin Biswas (BiswasHost)",
    "category": "Utility",
    "shortDescription": "Screenshot and screen recorder",
    "longDescription": "Select any area, annotate it, record it with system sound and a noise-filtered microphone, and save it as an image, MP4 or GIF.",
    "homepage": "https://github.com/wpexpertinbd/BHCapture",
    "linux": {
      "deb": {
        "depends": [
          "libopus0",
          "libpulse0",
          "curl"
        ]
      },
      "rpm": {
        "depends": [
          "opus",
          "pulseaudio-libs",
          "curl"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
