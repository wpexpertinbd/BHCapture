<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu-bar app: no Dock icon and no app-switcher entry. Every window it opens is either an
       overlay that hides itself or the settings window, reached from the tray. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Shown by macOS the first time a recording includes the microphone. Without it, macOS
       terminates the app the moment it touches the microphone. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>BHCapture records your microphone into screen recordings when you turn Microphone on.</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
</dict>
</plist>
