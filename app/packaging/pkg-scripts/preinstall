#!/bin/sh
#
# Runs as root BEFORE the new BHCapture.app is written, so the reinstall replaces a LIVE app rather
# than leaving the old copy running. Matched by EXACT executable path, not by name, so a development
# build running elsewhere is never touched. (A recording in progress is finished by the app itself on
# SIGTERM -- its file is kept and reopened at the next launch.)

PATTERN='^/Applications/BHCapture\.app/Contents/MacOS/bhcapture-app( |$)'

/usr/bin/pkill -TERM -f "$PATTERN" 2>/dev/null || true

i=0
while [ "$i" -lt 8 ]; do
    /usr/bin/pgrep -f "$PATTERN" >/dev/null 2>&1 || exit 0
    /bin/sleep 1
    i=$((i + 1))
done

/usr/bin/pkill -KILL -f "$PATTERN" 2>/dev/null || true
exit 0
